{
	"name": "autodirector-mirusuite",
	"version": "1.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build",
		"build": "rimraf dist && yarn run build:main && yarn run copyassets",
		"build:main": "tsc -p tsconfig.build.json",
		"test": "yarn build:main && node --test test/*.test.mjs",
		"dev": "yarn run copyassets && tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn run lint:raw .",
		"lint:fix": "yarn run lint:raw --fix",
		"generate-api": "npx openapi-typescript src/api/openapi.json --output src/api/openapi.ts",
		"copyassets": "copyfiles -u 1 src/api/openapi.json src/static/icon.png dist/",
		"test:package": "yarn package && node test/package-smoke.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-autodirector-mirusuite.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"eventsource": "^2.0.2",
		"jimp": "^0.22.12",
		"openapi-fetch": "^0.13.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"copyfiles": "^2.4.1",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"openapi-typescript": "^7.6.1",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": "^26",
		"yarn": "^4"
	}
}
